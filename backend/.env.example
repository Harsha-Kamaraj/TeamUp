# ─────────────────────────────────────────────────────────────
# Squadly Backend — Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file (it is gitignored).
# In production (Render) these are set in the dashboard, not in a file.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
# 5001 by default — macOS Control Center/AirPlay occupies port 5000.
# On Render this is provided automatically; do not set it there.
PORT=5001
API_PREFIX=/api/v1

# Where the frontend runs (used for CORS + email links + Socket.IO).
# Comma-separate multiple origins if needed.
# Production example: https://squadly.vercel.app
CLIENT_URL=http://localhost:5173

# Public URL of THIS backend (used to build absolute URLs for locally-stored
# uploads). Locally the default is fine; in production set your Render URL.
# Production example: https://squadly-api.onrender.com
SERVER_URL=http://localhost:5001

# Database — get this from MongoDB Atlas > Connect > Drivers.
# Put the REAL connection string in backend/.env (gitignored), NOT here.
# If your password has special characters, URL-encode them (e.g. @ becomes %40).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/squadly?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────────
# REQUIRED. Generate a strong secret with:  openssl rand -hex 64
JWT_ACCESS_SECRET=replace_with_a_long_random_string
# How long an access token is valid (e.g. 15m, 1h).
JWT_ACCESS_EXPIRES_IN=15m
# How long a refresh session lasts, in days.
REFRESH_TOKEN_EXPIRES_DAYS=7
# How long verification / password-reset links stay valid, in minutes.
EMAIL_TOKEN_EXPIRES_MINUTES=60
# Production only: cookie domain shared by frontend + backend (optional,
# usually NOT needed when frontend/backend are on different domains).
# COOKIE_DOMAIN=.yourdomain.com

# ── Email (Brevo SMTP) ───────────────────────────────────────
# Leave SMTP_* blank in development: emails are printed to the server
# console (including the verification / reset links) so you can test
# without any mail setup.
# In production, create a free Brevo account, verify a sender, and set:
EMAIL_FROM="Squadly <no-reply@squadly.app>"
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login@email.com
# SMTP_PASS=your-brevo-smtp-key

# ── Google Sign-In ───────────────────────────────────────────
# Optional. When unset, the Google button is hidden and normal email/password
# login still works. Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add your app's origins
# to "Authorized JavaScript origins" (e.g. http://localhost:5173 in dev).
# Only the client ID is needed — no client secret, no callback URL.
# The SAME value goes in the frontend as VITE_GOOGLE_CLIENT_ID.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ── Image upload — Cloudinary ────────────────────────────────
# Optional locally (uploads fall back to local disk when blank).
# REQUIRED in production: Render's disk is ephemeral, so without Cloudinary
# uploaded avatars are wiped on every restart/redeploy.
# Get these from your Cloudinary dashboard > Account Details.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
