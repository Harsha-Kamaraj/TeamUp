# ─────────────────────────────────────────────────────────────
# TeamUp Backend — Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file (it is gitignored).
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
# 5001 by default — macOS Control Center/AirPlay occupies port 5000.
PORT=5001
API_PREFIX=/api/v1

# Where the frontend runs (used for CORS + email links).
# Comma-separate multiple origins if needed.
CLIENT_URL=http://localhost:5173

# Database — get this from MongoDB Atlas > Connect > Drivers.
# Put the REAL connection string in backend/.env (gitignored), NOT here.
# If your password has special characters, URL-encode them (e.g. @ becomes %40).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/teamup?retryWrites=true&w=majority

# ── Auth (Phase 2) ───────────────────────────────────────────
# REQUIRED. Generate a strong secret with:  openssl rand -hex 64
JWT_ACCESS_SECRET=replace_with_a_long_random_string
# How long an access token is valid (e.g. 15m, 1h).
JWT_ACCESS_EXPIRES_IN=15m
# How long a refresh session lasts, in days.
REFRESH_TOKEN_EXPIRES_DAYS=7
# How long verification / password-reset links stay valid, in minutes.
EMAIL_TOKEN_EXPIRES_MINUTES=60
# Production only: cookie domain shared by frontend + backend (optional).
# COOKIE_DOMAIN=.yourdomain.com

# ── Email ────────────────────────────────────────────────────
# Leave SMTP_* blank in development: emails are printed to the server
# console (including the verification / reset links) so you can test
# without any mail setup. Real SMTP (Brevo/Resend) is wired up in Phase 9.
EMAIL_FROM="TeamUp <no-reply@teamup.local>"
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ── Image upload — Cloudinary (Phase 5) ──────────────────────
# Optional: leave blank to disable avatar uploads (the rest of the app still
# works). Get these from your Cloudinary dashboard > Account Details.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
