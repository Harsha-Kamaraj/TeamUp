# Squadly Frontend — environment variables (Vite exposes only VITE_* to the app)
# Copy to `.env` for local development.

# Base URL of the backend API. The Socket.IO URL is derived from this
# automatically (the /api/v1 suffix is stripped).
# Production example (set this in Vercel > Settings > Environment Variables):
#   VITE_API_URL=https://squadly-api.onrender.com/api/v1
VITE_API_URL=http://localhost:5001/api/v1
