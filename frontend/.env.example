# Squadly Frontend — environment variables (Vite exposes only VITE_* to the app)
# Copy to `.env` for local development.

# Base URL of the backend API.
# Local development: point straight at the backend dev server.
VITE_API_URL=http://localhost:5001/api/v1
#
# PRODUCTION (set in Vercel > Settings > Environment Variables):
#   VITE_API_URL=/api/v1
# Yes — a RELATIVE path, not the Render URL. vercel.json rewrites /api/* to the
# Render backend, so the browser sees the API as same-origin and the login
# cookie is first-party. Point this at Render directly and Safari/Brave will
# block the cookie, logging users out on every refresh.

# Origin of the backend for the Socket.IO (chat) connection.
# This must be the DIRECT backend URL — WebSockets can't go through Vercel's
# rewrite. Cross-origin is fine here: the socket authenticates with a token.
VITE_SOCKET_URL=http://localhost:5001
#
# PRODUCTION example:
#   VITE_SOCKET_URL=https://squadly-api.onrender.com

# Google Sign-In (optional). Same OAuth 2.0 Web client ID as the backend's
# GOOGLE_CLIENT_ID. When empty, the Google button is hidden and email/password
# login works normally. Create one at:
#   https://console.cloud.google.com/apis/credentials
# VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
